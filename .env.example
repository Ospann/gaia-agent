# Copy this file to .env and fill it in. Never commit .env!

HF_USERNAME=arystanmxn
AGENT_CODE_URL=https://github.com/Ospann/gaia-agent/tree/main

# HF read token; needed to fetch attachments from the gated gaia-benchmark/GAIA dataset
HF_TOKEN=

# Model (any LiteLLM id). Put the key of the matching provider below.
# Examples: gpt-4.1 | anthropic/claude-sonnet-4-5 | gemini/gemini-2.5-pro
MODEL_ID=anthropic/claude-sonnet-5-5

# OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Seconds before a hung LLM request is aborted, and how many times to retry it
LLM_TIMEOUT=120
LLM_RETRIES=2

MAX_STEPS=15
WHISPER_MODEL=small
